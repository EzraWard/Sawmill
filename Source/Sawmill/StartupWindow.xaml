<Window x:Class="Sawmill.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sawmill"
        Width="950"
        Height="650"
        MinWidth="520"
        MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="StartupActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="Sawmill" />
                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Minimize_Click"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{DynamicResource MaterialDesignBody}" />
                <Button Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Maximize_Click"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{DynamicResource MaterialDesignBody}" />
                <Button Grid.Column="3"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Close_Click"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{DynamicResource MaterialDesignBody}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource ContentAreaBrush}">
            <StackPanel MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Open a log file" />
                <TextBlock Margin="0,8,0,16"
                           HorizontalAlignment="Center"
                           Opacity="0.8"
                           Text="Sawmill is ready while your previous session loads." />
                <Button Width="120"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenFileCommand}"
                        Content="Open File..."
                        Style="{StaticResource StartupActionButton}" />
                <Button Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Padding="10,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenSettingsCommand}"
                        Content="Settings"
                        Foreground="{DynamicResource MaterialDesignBody}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
