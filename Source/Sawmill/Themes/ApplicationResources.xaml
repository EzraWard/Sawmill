<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sawmill.Controls"
    xmlns:fileDrop="clr-namespace:Sawmill.Views.FileDrop"
    xmlns:searching="clr-namespace:Sawmill.Views.Searching"
    xmlns:tail="clr-namespace:Sawmill.Views.Tail"
    xmlns:windowManagement="clr-namespace:Sawmill.Views.WindowManagement">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Sawmill;component/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="MaterialDesignFont">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="MaterialDesignBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="MaterialDesignBodySecondary" Color="#FFC7C7C7" />
    <SolidColorBrush x:Key="MaterialDesignTextBoxBorder" Color="#FF858585" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonClick" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#FF004578" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF8CC8FF" />
    <SolidColorBrush x:Key="ValidationErrorBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="GrayBrush2" Color="#FFADADAD" />
    <SolidColorBrush x:Key="SettingsMicaBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF767676" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SettingsCardBackgroundPointerOverBrush" Color="#FF343434" />
    <SolidColorBrush x:Key="SettingsCardBackgroundPressedBrush" Color="#FF292929" />
    <SolidColorBrush x:Key="SettingsCardBackgroundDisabledBrush" Color="#FF292929" />
    <SolidColorBrush x:Key="SettingsCardStrokeBrush" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="SettingsCardStrokePointerOverBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="SettingsCardDescriptionForegroundBrush" Color="#FFC7C7C7" />
    <SolidColorBrush x:Key="SettingsToggleTrackBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SettingsToggleTrackPointerOverBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="SettingsToggleTrackBorderBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="SettingsToggleTrackBorderPointerOverBrush" Color="#FFC7C7C7" />
    <SolidColorBrush x:Key="SettingsToggleThumbBrush" Color="#FFC7C7C7" />

    <Style x:Key="MaterialDesignFlatButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MaterialDesignFlatButtonClick}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MaterialDesignMenuCommandButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}" />
    <Style x:Key="MaterialDesignListBox" TargetType="{x:Type ListBox}" />
    <Style x:Key="MaterialDesignListBoxItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
    </Style>
    <Style x:Key="MaterialDesignComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" />
    <Style x:Key="MaterialDesignComboBoxItemSelectedCollapsedStyle" TargetType="{x:Type ComboBoxItem}" />
    <Style x:Key="MaterialDesignComboBoxToggleButton" TargetType="{x:Type ToggleButton}" />
    <Style x:Key="MaterialDesignTextBox" TargetType="{x:Type TextBox}" />
    <Style x:Key="MaterialDesignFloatingActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}" />
    <Style x:Key="MaterialDesignHamburgerToggleButton" TargetType="{x:Type ToggleButton}" />
    <Style x:Key="MaterialDesignTabablzControlStyle" TargetType="{x:Type TabControl}" />

    <DataTemplate DataType="{x:Type searching:SearchOptionsViewModel}">
        <searching:SearchOptionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type searching:IconSelector}">
        <searching:IconSelectorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tail:TailViewModel}">
        <tail:TailView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type windowManagement:StartTabViewModel}">
        <windowManagement:StartTabView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type fileDrop:FileDropContainer}">
        <Grid TextElement.Foreground="{DynamicResource MaterialDesignBody}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:FileIcon Width="22"
                               Height="22"
                               BorderThickness="0"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <ItemsControl Grid.Column="1"
                          Margin="4"
                          ItemsSource="{Binding Files}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
