<UserControl x:Class="Sawmill.Views.WindowManagement.StartTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:recent="clr-namespace:Sawmill.Views.Recent"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="Transparent"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu bar matching TailView style -->
        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,2"
                Background="{DynamicResource ToolbarBackgroundBrush}">
            <Grid MinHeight="36" KeyboardNavigation.TabNavigation="Cycle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center" Margin="4,0,8,0">
                    <MenuItem Header="File">
                        <MenuItem Header="Open File..." Command="{Binding OpenFileCommand}" />
                        <Separator />
                        <MenuItem Header="Open in Default App" IsEnabled="False" />
                        <MenuItem Header="Show in Explorer" IsEnabled="False" />
                        <MenuItem Header="Copy Path" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="ExitMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="Edit" IsEnabled="False">
                        <MenuItem Header="Copy" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="Clear" IsEnabled="False" />
                        <MenuItem Header="Un-Clear" IsEnabled="False" />
                    </MenuItem>
                    <MenuItem Header="View" IsEnabled="False">
                        <MenuItem Header="Follow Tail" IsEnabled="False" />
                        <MenuItem Header="Show Inline" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="Use Regex" IsEnabled="False" />
                    </MenuItem>
                </Menu>

                <Border Grid.Column="1" />

                <Border Grid.Column="2" />

                <ToggleButton Grid.Column="3"
                              Width="28"
                              Height="28"
                              Margin="4,0,2,0"
                              Padding="2"
                              VerticalAlignment="Center"
                              Visibility="Hidden"
                              IsHitTestVisible="False" />

                <TextBox Grid.Column="4"
                         MinWidth="200"
                         VerticalAlignment="Center"
                         Visibility="Hidden"
                         IsHitTestVisible="False" />

                <!-- Settings cog (right-aligned) -->
                <Button Grid.Column="5"
                        Width="32" Height="32"
                        Margin="4,0,12,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Settings"
                        Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                               Foreground="{DynamicResource MaterialDesignBody}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- Content area -->
        <Border Grid.Row="1" Background="{DynamicResource ContentAreaBrush}">
            <Grid Margin="24">
                <StackPanel Orientation="Vertical"
                            MaxWidth="700"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Padding="24"
                            CornerRadius="12"
                            Background="{DynamicResource SettingsCardBackgroundBrush}"
                            BorderBrush="{DynamicResource SettingsCardStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Open a log file"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Start by selecting a file to tail."
                                       Margin="0,8,0,16"
                                       Opacity="0.8"
                                       HorizontalAlignment="Center" />
                            <Button Content="Open File..."
                                    Width="120"
                                    HorizontalAlignment="Center"
                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                    Command="{Binding OpenFileCommand}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="RecentFilesBorder"
                            Margin="0,16,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="{DynamicResource SettingsCardBackgroundBrush}"
                            BorderBrush="{DynamicResource SettingsCardStrokeBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.RecentFiles.Files.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <recent:RecentFilesView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.RecentFiles}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
